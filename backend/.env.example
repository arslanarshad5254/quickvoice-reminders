# cPanel supplies PORT to Passenger. Keep 3000 only for local development.
NODE_ENV=production
PORT=3000
TRUST_PROXY=true
DATABASE_URL=postgresql://CPANEL_USER_dbuser:PASSWORD@localhost:5432/CPANEL_USER_quickvoice
DATABASE_SSL=false

# AI provider credentials stay on the server and are never shipped in the APK.
AI_API_KEY=replace_me
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=openai/gpt-oss-20b

AI_RATE_LIMIT_PER_MINUTE=20
AI_SEMANTIC_THRESHOLD=0.85

# Optional USD pricing used only for cost/savings metrics. Keep 0 if unknown.
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
